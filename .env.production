# Production values, loaded automatically by `vite build` (mode = production).
#
# This file IS committed on purpose. .env.local is ignored by git (*.local), so
# it never reaches a Netlify build — that left import.meta.env.VITE_API_URL
# undefined and made the chatbot throw "VITE_API_URL is missing. Check your
# .env.local file." before it ever sent a request.
#
# Everything here is prefixed VITE_, which means Vite inlines the value into the
# public client bundle where anyone can read it in the browser. Only public
# endpoint URLs belong here — never an API key, token or password.
#
# Priority note: .env.production overrides .env.local during a production build,
# and Netlify UI variables (Site configuration -> Environment variables) still
# win over both, because Vite never overwrites a variable that already exists in
# process.env. Use .env.production.local for a private one-off override.

# Chatbot AI endpoint — src/components/chatbots.jsx
VITE_API_URL=https://agrimonitorchatbot.netlify.app/.netlify/functions/index

# Dashboard AI endpoint — src/services/timelineGenerator.js (timeline generation,
# crop image analysis, recommendations, daily AI summary)
VITE_DASHBOARD_URL=https://agrimonitordashboard.netlify.app/.netlify/functions/index

# Weather alert notification webhook — src/services/weatherAlertService.js
# This is an ngrok dev URL and it rotates; update it here and redeploy when it does.
VITE_WEBHOOK_URL=https://lagoon-punk-capitol.ngrok-free.dev/webhook/test-webhook

# Disaster alert feed — src/services/disasterAlertService.js
# Left empty on purpose: with no URL the service serves its time-consistent
# mock feed instead of failing.
VITE_DISASTER_API_URL=

# Global commodity market feed — src/services/marketRateService.js
# (Global Market Rates page). If this is ever blank the service falls back to the
# same default endpoint, so the page keeps working.
VITE_MARKET_API_URL=https://test1936.netlify.app/.netlify/functions/market
