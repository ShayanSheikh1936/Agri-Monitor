// =============================================================================
// Firestore security rules — Agri Monitor
//
// Enforces the ownership model the app code already follows by path:
//   users/{uid}, crops/{uid}, timelineData/{uid}/crops/{cropId}/**
// A signed-in user may ONLY read/write documents under their own auth uid.
// The one exception is the Agri Doctor feature (collection `agriDoctor`), where
// a dedicated doctor account may also read/reply to every farmer's consult.
// Everything else is denied by default.
//
// DEPLOY (from the project root, one-time setup):
//   npm i -g firebase-tools
//   firebase login
//   firebase init firestore   (choose existing project agri-monitor-36080,
//                              rules file: firestore.rules, indexes: default)
//   firebase deploy --only firestore:rules
//
// IMPORTANT: verify current deployed rules BEFORE deploying these — if the
// project currently runs in open/test mode, lock it down as soon as possible.
// =============================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The dedicated Agri Doctor account (auto-provisioned on first portal
    // sign-in — see src/doctor/doctorAuth.js). Recognised by its auth email so
    // it can read/write EVERY farmer's consultation. Keep this in sync with
    // DOCTOR_EMAIL in src/services/agriDoctorService.js. To harden for
    // production, create this Firebase Auth user manually and rotate its
    // password rather than relying on the client-side gate.
    function isDoctor() {
      return isSignedIn()
        && request.auth.token.email == 'agridoctor@agrimonitor.app';
    }

    // True when the signed-in user owns the given Agri Doctor session doc.
    function ownsSession(sessionId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/agriDoctor/main/sessions/$(sessionId)).data.userId
           == request.auth.uid;
    }

    // ONE crop profile per consultation, chosen once and never changed.
    // While cropKey is still null the owner may set it; once set it must come
    // back unchanged. (Firestore merges updates, so request.resource.data
    // always carries the full post-write document — an update that never
    // touches cropKey therefore satisfies this automatically.)
    function cropLockRespected() {
      return resource.data.cropKey == null
        || request.resource.data.cropKey == resource.data.cropKey;
    }

    // User profile document (personal info, display photo).
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Crop profiles (existing collection — read/write by owner only).
    match /crops/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Personalized crop timeline subtree:
    // timelineData/{uid}/crops/{cropId}/events|activities|observations|
    // analyses|images|reviews/** — owner only, including all subcollections.
    match /timelineData/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Weather alert records (Weather Alert page): rooted at the auth uid so
    // user A can never read/modify user B's alerts — owner only.
    match /weatherAlerts/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Global Market Rates page — marketData/{uid}/favorites|analyses/**
    // and marketData/{uid}/settings/preferences. Rooted at the auth uid, so a
    // user can never read or modify another user's watchlist or saved AI
    // analyses — owner only.
    match /marketData/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // =========================================================================
    // Agri Doctor — consultation feature (collection root `agriDoctor`).
    //   agriDoctor/main                                     -> doctor's public profile
    //   agriDoctor/main/credits/{uid}                       -> farmer credit balance
    //   agriDoctor/main/slots/{slotKey}                     -> shared slot occupancy
    //   agriDoctor/main/sessions/{sessionId}                -> one consultation
    //   agriDoctor/main/sessions/{sessionId}/messages/{id}  -> chat thread
    // Farmers are scoped to their OWN records; the doctor account (isDoctor())
    // can read/write all of them so it can review photos and send an opinion.
    // =========================================================================

    // Hub document — holds the doctor's PUBLIC profile (name, qualification,
    // specialisation, languages). Every signed-in farmer reads it so the
    // console edit appears live; only the doctor account may write it.
    // Note: the doctor still gets NO access to crops/{uid} — the crop context
    // it needs is snapshotted onto the session doc by the farmer's client.
    match /agriDoctor/main {
      allow read: if isSignedIn() || isDoctor();
      allow write: if isDoctor();
    }

    // Credit balance — owner only (the doctor does not need it).
    match /agriDoctor/main/credits/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Shared slot occupancy — any signed-in user may read the schedule and
    // update seat counts. Over-booking / over-spend is prevented by the booking
    // TRANSACTION in agriDoctorService.bookSlot, not by these rules.
    match /agriDoctor/main/slots/{slotKey} {
      allow read, write: if isSignedIn() || isDoctor();
    }

    // Consultation session + its message thread.
    match /agriDoctor/main/sessions/{sessionId} {
      // A farmer may create a session only for themselves.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      // Owner (or doctor) may read/delete the session.
      allow read, delete: if isDoctor()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Owner updates must respect the one-crop lock; the doctor is exempt
      // (it never attaches a crop, but it does clear unread counters).
      allow update: if isDoctor()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && cropLockRespected());

      match /messages/{messageId} {
        // Read the thread of your own session; the doctor reads all.
        allow read: if isDoctor() || ownsSession(sessionId);
        // A farmer posts only as role "user" in their own session; the doctor
        // posts freely. Stops a farmer from forging a "doctor" message.
        allow create: if isDoctor()
          || (ownsSession(sessionId) && request.resource.data.senderRole == 'user');
        // Only the doctor edits/deletes messages (farmers never do in-app).
        allow update, delete: if isDoctor();
      }
    }
  }
}
