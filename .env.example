# Chatbot AI endpoint: POST {prompt, lang, image, location} -> {reply}
# Consumed by src/components/chatbots.jsx
VITE_API_URL="API URL HERE"

# Dashboard AI endpoint: timeline generation, crop image analysis,
# recommendations and the daily AI summary.
# Consumed by src/services/timelineGenerator.js
VITE_DASHBOARD_URL="URL HERE"

# Notification webhook endpoint (ngrok dev URLs change — keep it configurable here).
# Used by the Weather Alert notification flow; leave empty to disable webhook sends.
VITE_WEBHOOK_URL="URL HERE"

# Disaster alert feed. Consumed by src/services/disasterAlertService.js
# Leave empty to serve the built-in time-consistent mock feed instead.
VITE_DISASTER_API_URL=""

# Global commodity market feed. Consumed by src/services/marketRateService.js
# (Global Market Rates page). Leave empty to fall back to the built-in default
# endpoint baked into the service.
VITE_MARKET_API_URL=""

# IMPORTANT: .env.local is gitignored (by the *.local rule), so it never reaches
# a Netlify build. The committed production values live in .env.production, which
# `vite build` loads automatically — add every new key there too, or it will be
# undefined in production.
# Netlify -> Site configuration -> Environment variables overrides both files.
# The VITE_ prefix is mandatory for Vite to inline a value into the bundle.